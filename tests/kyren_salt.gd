extends SceneTree
const Salt = preload("res://scripts/kyren_salt.gd")
const Dialogue = preload("res://scripts/kyren_dialogue.gd")
const Progress = preload("res://scripts/kyren_progress.gd")
const Journal = preload("res://scripts/encounter_progress.gd")
var checks := 0
var failures := 0
var serial := 0
func _initialize() -> void: call_deferred("run")
func check(ok: bool, label: String) -> void:
	checks+=1
	if ok: print("PASS: ",label)
	else:
		failures+=1
		push_error("FAIL: "+label)
func event(extra: Dictionary = {}) -> Dictionary:
	serial+=1
	var data := {"event_id":str(serial),"attack_key":str(serial),"damage":1.0,"health_ratio":1.0,"incoming":{"item_id":"katana","action":"attack_right"}}
	data.merge(extra,true)
	return data
func run() -> void:
	var salt := Salt.new()
	root.add_child(salt)
	check(salt.value==10 and salt.state()==&"smug","Initial salt is 10% and smug")
	salt.set_value(INF)
	check(salt.value==10,"Nonfinite debug/save input cannot poison salt")
	salt.set_value(-10)
	check(salt.value==0,"Lower bound clamps")
	salt.set_value(999)
	check(salt.value==100,"Upper bound clamps")
	for value in [0,24,25,49,50,74,75,100]:
		salt.set_value(value)
		check(salt.state()==([&"smug",&"smug",&"annoyed",&"annoyed",&"salty",&"salty",&"meltdown",&"meltdown"][[0,24,25,49,50,74,75,100].find(value)]),"State threshold "+str(value))
	salt.set_value(10)
	salt.begin()
	var hit := event()
	salt.contact(hit,true)
	check(salt.value==12,"A clean hit adds two")
	check(not salt.contact(hit,true) and salt.value==12,"Repeated signal for the same contact is ignored")
	salt.contact(event({"health_ratio":.49,"damage":0}),true)
	check(salt.value==22,"The half-health threshold triggers once")
	salt.contact(event({"health_ratio":.49,"damage":0}),true)
	check(salt.value==22,"Half-health cannot be farmed")
	salt.contact(event({"health_ratio":.19,"damage":0}),true)
	check(salt.value==37,"The low-health threshold adds fifteen")
	salt.contact(event({"health_ratio":.19,"damage":0}),true)
	check(salt.value==37,"Low-health cannot be farmed")
	salt.begin()
	salt.set_value(10)
	salt.contact(event({"dodging":true,"interrupted_charge":true,"attacker_airborne":true,"attacker_speed":20}),true)
	check(salt.value==37,"A real vulnerable dodge hit, aerial momentum and interrupted charge add their configured bonuses")
	salt.contact(event({"damage":0,"outcome":&"evaded","dodging":true}),true)
	check(salt.value==37,"A successful iframe dodge awards no hit bonus")
	salt.begin()
	salt.set_value(10)
	salt.contact(event(),true)
	salt.contact(event(),true)
	check(salt.value==19,"Repeating a successful technique adds five beyond clean hits")
	var multi := event({"attack_key":str(serial)})
	salt.contact(multi,true)
	check(salt.value==21,"A second pulse of one technique cannot farm the repeat bonus")
	salt.begin()
	salt.set_value(10)
	for i in range(3): salt.contact(event({"damage":0,"outcome":&"parry"}),false)
	check(salt.value==46 and salt.consecutive_parries==3,"Three consecutive player parries add 24 plus the twelve-point streak bonus")
	salt.contact(event({"damage":0,"outcome":&"parry"}),false)
	check(salt.value==54,"The same parry streak cannot repeatedly award its bonus")
	salt.contact(event({"damage":0,"blocked":true}),false)
	check(salt.consecutive_parries==0,"A blocked or missed opportunity breaks the parry streak")
	salt.begin()
	salt.set_value(50)
	salt.contact(event({"damage":0,"outcome":&"parry"}),true)
	check(salt.value==47,"Kyren's parry reduces salt by three")
	salt.contact(event(),false)
	check(salt.value==45,"A clean counter after Kyren's parry reduces salt by two")
	salt.contact(event(),false)
	check(salt.value==45,"An unrelated later hit is not another free counter reduction")
	salt.end(true,3,3)
	check(salt.value==75 and salt.lingering_floor==19,"Repeated defeats escalate salt and preserve lingering frustration")
	salt.advance(1000)
	check(salt.value==19,"Outside-combat decay stops at the history-based floor")
	salt.begin()
	salt.set_value(60)
	salt.advance(10)
	check(salt.value==60,"Salt does not decay during combat")
	salt.end(false,0,3)
	check(salt.value==45,"Winning reduces salt by fifteen")
	var dialogue := Dialogue.new()
	root.add_child(dialogue)
	dialogue.silence_chance=0
	check(dialogue.lines.size()==153,"The full supplied dialogue library and rare reactions load as editable data")
	check(dialogue.say(&"player_hit",30,{"combat":true},true),"Resolved player hit selects a matching reaction")
	var id := dialogue.current_id
	check(not dialogue.say(&"player_hit",30,{},true) and dialogue.current_id==id,"Global cooldown prevents rapid-combo subtitle spam")
	dialogue.advance(1)
	check(dialogue.say(&"parry_domination",70,{"combat":true},true) and dialogue.current_text=="STOP READING MY INPUTS!","An important genuine parry streak overrides an ordinary hit reaction")
	dialogue.advance(10)
	check(not dialogue.say(&"parry_domination",70,{},true),"A line cannot immediately repeat even when its global timer expires")
	var mailbox: Dictionary
	for line: Dictionary in dialogue.lines:
		if "mailbox_contact" in line.triggers: mailbox=line; break
	check(not dialogue.eligible(mailbox,&"house_contact",50,{}),"Undetected mailbox events cannot masquerade as house contact")
	dialogue.queue_special(["three_defeats_first","three_defeats_second"])
	check(dialogue.current_text=="YOU KNOW WHAT? FINE! YOU WIN! HAPPY?!","Third-defeat exchange starts with the exact supplied line")
	dialogue.advance(6)
	check(dialogue.current_text=="Still think you’re cheating, though.","The second rare line follows after a pause on the same subtitle channel")
	var progress := Progress.fresh()
	check(Progress.valid(progress),"Fresh history passes existing journal plus Kyren metadata validation")
	progress.kyren.salt=INF
	check(not Progress.valid(progress),"Invalid salt in a checkpoint is rejected")
	progress=Progress.fresh()
	var path := "user://tests/kyren_salt.json"
	check(Journal.store(path,"fixture",{"kyren":progress,"greefer":Journal.fresh()})==OK,"Kyren and Greefer share the owner-scoped atomic journal")
	check(Progress.valid(Journal.read(path,"fixture").kyren) and Journal.read(path,"different-owner").is_empty(),"History round-trips and rejects another owner's checkpoint")
	salt.queue_free()
	dialogue.queue_free()
	await process_frame
	print("KYREN SALT: ",checks," checks, ",failures," failures")
	quit(1 if failures else 0)
